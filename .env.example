# ==============================================================================
# BARBOYA - Docker Compose & Coolify Environment Configuration Template
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo a `.env` (`cp .env.example .env`)
# 2. Genera claves seguras para SECRET_KEY y POSTGRES_PASSWORD
#    Puedes generar claves criptográficas seguras con:
#    python -c "import secrets; print(secrets.token_urlsafe(48))"
# 3. Nunca hagas commit del archivo `.env` al repositorio de git.
# ==============================================================================

# Entorno general: 'development' | 'staging' | 'production'
ENVIRONMENT=production

# Clave secreta para firma de tokens y seguridad (Mínimo 32 caracteres obligatorios en producción)
SECRET_KEY=genera_aqui_una_clave_criptografica_segura_de_al_menos_32_caracteres

# Configuración de Base de Datos PostgreSQL
POSTGRES_USER=barboya_prod_user
POSTGRES_PASSWORD=genera_aqui_un_password_seguro_para_postgres
POSTGRES_DB=barboya_production_db

# URL de conexión SQLAlchemy asíncrona para el backend
# Si usas el servicio db del docker-compose:
DATABASE_URL=postgresql+asyncpg://barboya_prod_user:genera_aqui_un_password_seguro_para_postgres@db:5432/barboya_production_db

# URL de conexión a Redis (con o sin contraseña)
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# Orígenes CORS permitidos (separados por coma o JSON array)
# En producción DEBE ser la lista de dominios autorizados de la app/web (NO usar '*')
ALLOWED_ORIGINS=https://barboya.com,https://app.barboya.com

# Puerto público en el host para el backend
PORT=8000

# Ejecución automática de migraciones Alembic al iniciar el contenedor (true/false)
RUN_MIGRATIONS=true

# Habilitar documentación interactiva Swagger (/docs) en producción (por defecto false)
ENABLE_DOCS=false

# Administrador inicial del sistema
ADMIN_EMAIL=admin@barboya.com
ADMIN_PASSWORD=genera_aqui_un_password_admin_seguro
