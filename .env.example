# ===================================================
# Variables de Entorno para BarboYa (Coolify / Docker)
# ===================================================

# Base de datos PostgreSQL
POSTGRES_USER=barboya
POSTGRES_PASSWORD=generate_a_secure_password_here
POSTGRES_DB=barboya_db
DATABASE_URL=postgresql+asyncpg://barboya:generate_a_secure_password_here@postgres:5432/barboya_db

# Seguridad Backend (JWT)
SECRET_KEY=generate_a_random_32_character_secret_key_here
ENVIRONMENT=production

# CORS (Dominio del frontend en producción, ej: https://app.tudominio.com o ["*"])
ALLOWED_ORIGINS=["*"]

# Credenciales de Administrador Inicial
ADMIN_EMAIL=admin@barboya.com
ADMIN_PASSWORD=CambiarPasswordSeguro123*
