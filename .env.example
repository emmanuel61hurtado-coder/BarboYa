# ===================================================
# Variables de Entorno para BarboYa (Coolify / Docker Compose)
# Copia estas variables en la pestaña 'Environment Variables' de tu recurso en Coolify.
# ===================================================

# ---- Base de datos PostgreSQL ----
POSTGRES_USER=barboya
POSTGRES_PASSWORD=COLOCA_AQUI_UNA_PASSWORD_SEGURA_ALEATORIA
POSTGRES_DB=barboya_db

# ---- Backend (FastAPI) ----
# URL de conexión a la base de datos (usa el nombre del servicio 'postgres' de Docker)
DATABASE_URL=postgresql+asyncpg://barboya:TU_PASSWORD_SEGURA@postgres:5432/barboya_db

# Seguridad Backend (Firma JWT) - Debe tener mínimo 32 caracteres
# Genera una con: openssl rand -hex 32
SECRET_KEY=COLOCA_AQUI_UNA_CLAVE_ALEATORIA_DE_MINIMO_32_CARACTERES

# Entorno: 'development' o 'production'
ENVIRONMENT=production

# CORS (Dominios permitidos, ej: ["*"] o ["https://miapp.com"])
ALLOWED_ORIGINS=["*"]

# Credenciales de Administrador Inicial
ADMIN_EMAIL=admin@barboya.com
ADMIN_PASSWORD=COLOCA_AQUI_UNA_PASSWORD_ADMIN_SEGURA

# ---- Frontend (React/Vite) ----
# URL del API backend. En Coolify, usa la URL pública de tu backend.
# Ejemplo con proxy reverso: /api/v1
# Ejemplo con dominio separado: https://api.barboya.com/api/v1
VITE_API_URL=/api/v1
VITE_USE_MOCKS=false
