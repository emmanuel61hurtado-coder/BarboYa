# ==============================================================================
# BARBOYA - Backend Environment Configuration Template
# ==============================================================================
# INSTRUCCIONES:
# Copia este archivo a `.env` dentro de backend/ para desarrollo local o tests.
# ==============================================================================

PROJECT_NAME="BarboYa Súper App API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Clave secreta para tokens JWT (En producción DEBE ser de al menos 32 caracteres)
SECRET_KEY="insecure_dev_key_only_must_be_overridden_in_production_with_at_least_32_chars"

# Conexión asíncrona a PostgreSQL
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/barboya_dev"

# Conexión a Redis
REDIS_URL="redis://localhost:6379/0"

# Parámetros de Tokens JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Orígenes CORS permitidos (en desarrollo ["*"], en producción lista de URLs)
ALLOWED_ORIGINS=["*"]

# Funcionalidades adicionales
ENABLE_TRANSPORT_PEOPLE=false
ENABLE_DOCS=true

# Cuenta inicial de Administrador
ADMIN_EMAIL="admin@barboya.com"
ADMIN_PASSWORD=""
PORT=8000
