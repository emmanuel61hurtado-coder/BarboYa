# Copia este archivo como .env en la raíz del repositorio o define estas
# variables directamente en Coolify (Environment Variables).
ENVIRONMENT=production

# PostgreSQL (servicio "db" del docker-compose)
POSTGRES_USER=barboya
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_HOST=db
POSTGRES_DB=barboya
# Si se deja vacio, la API arma la URL con las variables POSTGRES_* anteriores.
DATABASE_URL=

# Redis (servicio "redis" del docker-compose)
REDIS_URL=redis://redis:6379/0

# En producción SIEMPRE false: usa PostgreSQL + PostGIS.
USE_SQLITE=false

# Obligatorio en producción: secreto largo y aleatorio.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Orígenes permitidos por CORS (lista JSON).
CORS_ORIGINS=["https://app.barboya.co"]

# Puerto publicado del API
API_PORT=8000

# Tarifas (COP)
PRICE_DAILY_COP=3000
PRICE_WEEKLY_COP=15000
PRICE_MONTHLY_COP=50000
DEFAULT_TRIP_FEE_COP=300

# Almacenamiento de archivos
S3_BUCKET=barboya-media
